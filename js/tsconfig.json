{
  "extends": "flarum-tsconfig",
  "include": [
    "src/**/*"
  ],
  "compilerOptions": {
    "jsx": "react",
    "jsxFactory": "m",
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "flarum/*": [
        "../../../../app/vendor/flarum/core/js/dist-typings/*",
        "../vendor/flarum/core/js/dist-typings/*"
      ]
    }
  }
}
